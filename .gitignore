# --- environments and caches -------------------------------------------------
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/

# --- raw and derived data ----------------------------------------------------
# Raw sources are not redistributed: UCI Air Quality is public (10.24432/C59K5F)
# and the Wörner contrast archive is at 10.5281/zenodo.15681119. Provenance JSON
# with checksums is kept under version control instead.
data/raw/*
data/external/*
data/processed/*
!data/raw/.gitkeep
!data/external/.gitkeep
!data/processed/.gitkeep
!data/*/*provenance*.json

# --- row-level benchmark results go to the Zenodo DATA record ----------------
# Ten panel draws x 1.10 MB each. The derived summaries, decision cells, figures
# and tables that the manuscript actually cites stay under version control; the
# row-level tables are archived separately as a dataset (see README).
results/seed_sensitivity/seed_*/tables/benchmark_results.csv
results/seed_sensitivity/seed_*/logs/
results/*/tables/benchmark_results.csv

# --- stray caches and one-off submission material ---------------------------
artifacts/tmp/
submission_measurement/

# Downloaded third-party papers: not ours to redistribute.
artifacts/papers/

# --- the manuscript itself is NOT published here -----------------------------
# docs/double_anonymized_repository_plan.md requires that reviewer-visible
# material not be linkable to author identity. This repository is public under a
# named account, so shipping the manuscript would let a reviewer identify the
# author from a distinctive phrase and would defeat double-anonymised review.
# The v1.0.0 Zenodo code record likewise contained no manuscript directory.
# Tables and figures the manuscript cites are regenerable: see
# scripts/generate_uci360_tables.py and scripts/generate_uci360_figures.py.
manuscript/
latex/

# Manuscript-production tooling, unusable without the two directories above.
scripts/build_latex.py
scripts/verify_latex_build.py

# --- withdrawn Measurement submission ---------------------------------------
# Retained locally as the record of the withdrawn submission, not released.
MEAS-*.pdf
reject*
claude --resume*
The VLDB Journal
When Do Zero-Shot*
artifacts/MEASUREMENT_SUBMISSION_CHECKLIST.md
configs/measurement_venue_profile.yaml
docs/measurement_official_check.md
docs/measurement_paper_outline.md
docs/paper_positioning_measurement.md
docs/revised_protocol_measurement.md
docs/double_anonymized_repository_plan.md

# --- LaTeX build intermediates ----------------------------------------------
latex/*.aux
latex/*.log
latex/*.out
latex/*.spl
latex/*.bbl
latex/*.blg
latex/*.fls
latex/*.fdb_latexmk
latex/_preview/

# Built release archives: regenerate with scripts/build_zenodo_packages.py
release/
release_check/

# --- not part of the reproducible research -----------------------------------
# Project convention: the repository carries code, raw results, protocols and
# dataset manifests. Narrative summaries, status documents, working notes for the
# withdrawn submission, and the original topic proposal are kept locally only.
artifacts/ARGUMENT_BLUEPRINT.md
artifacts/FINAL_COMPLIANCE_AUDIT.md
artifacts/FINAL_LOCAL_RECHECK.md
artifacts/LITERATURE_SEARCH_REPORT.md
artifacts/ANNOTATED_BIBLIOGRAPHY.md
artifacts/SOURCE_TO_CLAIM_MATRIX.md
artifacts/PIVOT_DECISION.md
artifacts/PROJECT_STATUS.md
artifacts/EXPERIMENT_RESULT.md
候选一：气体传感器漂移下的再校准策略评测.md

# --- submission materials ----------------------------------------------------
# One-off files for a specific journal submission, and the script that builds
# them from manuscript/, which is itself excluded above.
submission_cils/
scripts/build_submission_docs.py
# Instructions for editing the Zenodo records' metadata: administrative, not a
# research record, so it stays out for the same reason the proposal did.
artifacts/ZENODO_TITLE_UPDATE.md
